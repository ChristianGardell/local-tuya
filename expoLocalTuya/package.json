{
  "name": "expolocaltuya",
  "version": "1.0.0",
  "main": "index.tsx",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:release": "expo prebuild --platform android --no-install && expo run:android --variant release",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "dupe": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "cd .. && husky expoLocalTuya/.husky"
  },
  "dependencies": {
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/bottom-tabs": "^7.18.3",
    "@react-navigation/elements": "^2.9.26",
    "@react-navigation/native": "^7.3.4",
    "@react-navigation/native-stack": "^7.17.6",
    "expo": "^56.0.12",
    "expo-asset": "~56.0.17",
    "expo-dev-client": "~56.0.20",
    "expo-linking": "~56.0.18",
    "expo-splash-screen": "~56.0.10",
    "expo-system-ui": "~56.0.5",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "knip": "^6.40.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3"
  },
  "private": true
