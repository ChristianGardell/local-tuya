{
  "expo": {
    "name": "expoLocalTuya",
    "slug": "expoLocalTuya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "expolocaltuya",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.expolocaltuya"
    },
    "platforms": ["android"],
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fafaf9",
          "image": "./assets/splash-lamp.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0c0a09"
          }
        }
      ]
    ]
  }
}
